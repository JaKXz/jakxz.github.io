{
  "prettier": {
    "allowed": false
  },
  "format_on_save": "on",
  "formatter": [
    { "code_action": "source.fixAll.oxc" },
    {
      "language_server": {
        "name": "oxfmt"
      }
    }
  ],
  // "language_servers": ["!ast-grep", "!eslint", "!jj_lsp", "!tailwindcss-language-server", "..."],
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": "./vite.config.ts",
          "run": "onSave"
        }
      }
    }
  }
}
