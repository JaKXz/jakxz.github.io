{
  "name": "jason-kurian-portfolio",
  "private": true,
  "type": "module",
  "imports": {
    "#assets/*": "./src/lib/assets/*",
    "#components/*": "./src/lib/components/*",
    "#lib/*": "./src/lib/*",
    "#posts/*": "./src/lib/posts/*",
    "#server/*": "./src/lib/server/*"
  },
  "scripts": {
    "build": "vp build",
    "check": "svelte-check && vp check",
    "predeploy": "pnpm dedupe && test -z \"$(git status --porcelain)\" && pnpm run build",
    "deploy": "gh-pages -d build -b main --dotfiles --nojekyll --cname \"jasonkurian.dev\" --tag $(git rev-parse --short HEAD)",
    "dev": "vp dev",
    "format": "vp fmt",
    "lint": "vp lint",
    "prepare": "vp config --no-agent",
    "preview": "vp preview",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs",
    "test": "vp test"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "1.2.6",
    "@mdsvex/plugin-anchors": "0.1.1",
    "@mdsvex/plugin-external-links": "0.1.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-devtools-svelte": "^0.11.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.6.6",
    "@unocss/extractor-svelte": "66.13.0",
    "@unocss/transformer-directives": "66.13.0",
    "@vitejs/devtools": "^0.8.3",
    "clsx": "^2.1.1",
    "gh-pages": "6.3.0",
    "mdsvex": "1.1.0",
    "sass": "1.108.2",
    "svelte": "5.59.2",
    "svelte-check": "^4.7.5",
    "svelte-preprocess": "6.0.5",
    "tailwind-merge": "^3.7.1",
    "typescript": "^6.0.3",
    "unocss": "66.13.0",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "1.1.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  }
}
