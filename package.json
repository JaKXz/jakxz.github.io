{
  "name": "jason-kurian-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "check": "svelte-check && vp check",
    "predeploy": "pnpm dedupe && test -z \"$(git status --porcelain)\" && pnpm run build",
    "deploy": "gh-pages -d build -b main --dotfiles --nojekyll --cname \"jasonkurian.dev\" --tag $(git rev-parse --short HEAD)",
    "dev": "vp dev",
    "format": "vp fmt",
    "lint": "vp lint",
    "prepare": "vp config --no-agent",
    "preview": "vp preview",
    "test": "vp test"
  },
  "dependencies": {
    "svelte-preprocess": "6.0.5"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "1.2.6",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.6.2",
    "@unocss/extractor-svelte": "66.10.5",
    "@unocss/transformer-directives": "66.10.5",
    "clsx": "^2.1.1",
    "gh-pages": "6.3.0",
    "mdsvex": "0.12.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "sass": "1.104.1",
    "svelte": "5.57.1",
    "svelte-check": "^4.5.0",
    "tailwind-merge": "^3.6.0",
    "unocss": "66.10.5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  }
}
