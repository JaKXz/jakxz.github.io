{
	"name": "jason-kurian-portfolio",
	"private": true,
	"scripts": {
		"build": "vite build",
		"predeploy": "pnpm dedupe && test -z \"$(git status --porcelain)\" && pnpm run build",
		"deploy": "gh-pages -d build -b main --dotfiles --nojekyll --cname \"jasonkurian.dev\" --tag $(git rev-parse --short HEAD)",
		"dev": "vite",
		"lint": "oxlint",
		"preview": "pnpm run dev preview",
		"test": "svelte-check && vitest"
	},
	"devDependencies": {
		"@iconify-json/radix-icons": "1.2.6",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^25.3.2",
		"@unocss/extractor-svelte": "66.6.4",
		"@unocss/transformer-directives": "66.6.4",
		"clsx": "^2.1.1",
		"gh-pages": "6.3.0",
		"mdsvex": "0.12.6",
		"oxlint": "^1.50.0",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "3.5.1",
		"pretty-quick": "^4.0.0",
		"rehype-autolink-headings": "7.1.0",
		"rehype-external-links": "3.0.0",
		"rehype-slug": "6.0.0",
		"sass": "1.97.3",
		"simple-git-hooks": "^2.11.1",
		"svelte": "5.53.6",
		"svelte-check": "^4.4.4",
		"tailwind-merge": "^3.0.1",
		"unocss": "66.6.4",
		"vite": "7.3.1",
		"vitest": "4.0.18"
	},
	"simple-git-hooks": {
		"pre-commit": "npx pretty-quick --staged"
	},
	"type": "module",
	"dependencies": {
		"dotenv": "17.3.1",
		"just-throttle": "4.2.0",
		"svelte-preprocess": "6.0.3"
	}
}
