{
	"name": "jason-kurian-portfolio",
	"private": true,
	"scripts": {
		"build": "vite build",
		"predeploy": "pnpm dedupe && test -z \"$(git status --porcelain)\" && pnpm run build",
		"deploy": "gh-pages -d build -b main --dotfiles --nojekyll --cname \"jasonkurian.dev\" --tag $(git rev-parse --short HEAD)",
		"dev": "vite",
		"lint": "oxlint",
		"preview": "pnpm run dev preview",
		"test": "svelte-check && vitest"
	},
	"devDependencies": {
		"@iconify-json/radix-icons": "1.2.6",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.6.2",
		"@unocss/extractor-svelte": "66.7.3",
		"@unocss/transformer-directives": "66.7.3",
		"clsx": "^2.1.1",
		"gh-pages": "6.3.0",
		"mdsvex": "0.12.7",
		"oxlint": "^1.68.0",
		"prettier": "3.8.4",
		"prettier-plugin-svelte": "4.1.0",
		"pretty-quick": "^4.0.0",
		"rehype-autolink-headings": "7.1.0",
		"rehype-external-links": "3.0.0",
		"rehype-slug": "6.0.0",
		"sass": "1.101.0",
		"simple-git-hooks": "^2.11.1",
		"svelte": "5.56.3",
		"svelte-check": "^4.5.0",
		"tailwind-merge": "^3.6.0",
		"unocss": "66.7.3",
		"vite": "8.0.16",
		"vitest": "4.1.8"
	},
	"simple-git-hooks": {
		"pre-commit": "npx pretty-quick --staged"
	},
	"type": "module",
	"dependencies": {
		"dotenv": "17.4.2",
		"just-throttle": "4.2.0",
		"svelte-preprocess": "6.0.5"
	}
}
